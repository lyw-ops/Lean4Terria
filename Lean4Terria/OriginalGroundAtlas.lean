private def root : UInt16 → Option Int
  | 0 => some 301
  | 1 => some 355
  | 2 => some 523
  | 38 => some 538
  | 40 => some 538
  | 53 => some 538
  | 59 => some 538
  | 147 => some 538
  | 161 => some 538
  | _ => none

/-- The neighbors are top, bottom, left, right, bottom left, bottom right,
top left, and top right. The original mixed atlas for dirt, stone, and
grass distinguishes those three materials. The other atlases are sampled
for matching material against empty cells. -/
def frame (center : UInt16) (neighbors : Array (Option UInt16)) (variation : Nat) : Option (Nat × Nat) := do
  let mut node ← root center
  for _ in [:8] do
    if node < 0 then break
    let (offset, empty, dirt, stone, grass) ← branches[node.toNat]?
    let neighbor : UInt16 := (neighbors[offset]?.getD none).getD 65535
    node := if center ≤ 2 then
      match neighbor with
      | 0 => dirt
      | 1 => stone
      | 2 => grass
      | _ => empty
    else if neighbor == center then dirt else empty
  if node ≥ 0 then none
  else atlas[(-node - 1).toNat]?.bind (·[variation % 3]?)

end Lean4Terria.OriginalGroundAtlas

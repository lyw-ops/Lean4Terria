private def hasUseStyleTable : Array Bool := Id.run do
  let mut table := Array.replicate 6196 true
  table := table.set! 0 false
  for (first, last) in withoutUseStyle do
    for id in [first:last + 1] do
      table := table.set! id false
  return table

def hasUseStyle (item : UInt16) : Bool :=
  hasUseStyleTable[item.toNat]?.getD false

/-- Native Item.FitsAmmoSlot on the default instance of each 1.4.5.8 item. -/
def fitsAmmoSlot (item : UInt16) : Bool :=
  let id := item.toNat
  let ranges : Array (Nat × Nat) := #[
    (23, 23), (40, 41), (47, 47), (51, 51), (75, 75), (97, 97), (234, 234), (265, 265),
    (278, 278), (283, 283), (353, 353), (515, 516), (530, 530), (545, 546), (771, 774), (780, 784),
    (849, 849), (931, 931), (949, 949), (988, 988), (1073, 1099), (1179, 1179), (1235, 1235), (1261, 1261),
    (1302, 1302), (1310, 1310), (1334, 1335), (1341, 1342), (1349, 1352), (1614, 1614), (1783, 1783), (1785, 1785),
    (1836, 1836), (1966, 1968), (1992, 1992), (1994, 2002), (2004, 2004), (2006, 2007), (2156, 2157), (2436, 2438),
    (2673, 2676), (2740, 2740), (2772, 2773), (2775, 2775), (2777, 2778), (2780, 2780), (2782, 2783), (2785, 2785),
    (2881, 2881), (2891, 2891), (2893, 2893), (2895, 2895), (3003, 3003), (3009, 3011), (3103, 3104), (3108, 3108),
    (3191, 3194), (3462, 3463), (3465, 3465), (3567, 3568), (3847, 3851), (3861, 3862), (3978, 3978), (4010, 4010),
    (4058, 4058), (4334, 4340), (4361, 4363), (4418, 4419), (4445, 4449), (4457, 4459), (4668, 4668), (4722, 4722),
    (4845, 4845), (4847, 4847), (4849, 4849), (4915, 4915), (5132, 5132), (5344, 5344), (5348, 5348), (5377, 5380),
    (5392, 5394), (6143, 6143), (6160, 6160), (6170, 6171)
  ]
  id == 0 || ranges.any fun (start, stop) => start ≤ id && id ≤ stop

def maxStack (item : UInt16) : Nat :=
  if 71 ≤ item && item ≤ 73 then 100
  else if (#[58, 184, 1734, 1735, 1867, 1868, 1922, 3453, 3454, 3455] : Array UInt16).contains item then 1
  else 9999

/-- FitsAmmoSlot also admits bait, paint and other manually placed items.
Player.FillAmmo only opens a new slot for the automatic subset. -/
def autoFillAmmoSlot (item : UInt16) : Bool :=
  let id := item.toNat
  let manual : Array (Nat × Nat) := #[
    (23, 23), (75, 75), (353, 353), (849, 849), (1073, 1099), (1966, 1968),
    (1992, 1992), (1994, 2002), (2004, 2004), (2006, 2007), (2156, 2157),
    (2436, 2438), (2673, 2676), (2740, 2740), (2891, 2891), (2893, 2893),
    (2895, 2895), (3191, 3194), (4334, 4340), (4361, 4363), (4418, 4419),
    (4668, 4668), (4845, 4845), (4847, 4847), (4849, 4849), (5132, 5132), (5344, 5344)
  ]
  fitsAmmoSlot item && !manual.any (fun (start, stop) => start ≤ id && id ≤ stop)

/-- The narrower ammo predicate used by ItemSpace to admit a new ammo slot.
Item.FitsAmmoSlot also includes items the player can place there by hand. -/
def isAmmoOnPickup (item : UInt16) : Bool :=
  let id := item.toNat
  let ranges : Array (Nat × Nat) := #[
    (23, 23), (40, 41), (47, 47), (51, 51), (75, 75), (97, 97), (234, 234),
    (265, 265), (278, 278), (283, 283), (515, 516), (545, 546), (771, 774),
    (780, 784), (931, 931), (949, 949), (988, 988), (1179, 1179), (1235, 1235),
    (1261, 1261), (1302, 1302), (1310, 1310), (1334, 1335), (1341, 1342),
    (1349, 1352), (1614, 1614), (1783, 1783), (1785, 1785), (1836, 1836),
    (3003, 3003), (3009, 3011), (3103, 3104), (3108, 3108), (3567, 3568),
    (4445, 4449), (4457, 4459), (4915, 4915), (5348, 5348), (5377, 5380), (5392, 5394)
  ]
  ranges.any fun (start, stop) => start ≤ id && id ≤ stop

/-- Restock reads Item.ammo directly, before checking the slot's context. -/
def hasAmmoType (item : UInt16) : Bool :=
  isAmmoOnPickup item ||
    (#[27, 71, 72, 73, 74, 169, 353, 370, 408, 1246] : Array UInt16).contains item

def canGoInVoidVault (item : UInt16) : Bool :=
  item != 3822 && !(2450 ≤ item && item ≤ 2488) && !(4393 ≤ item && item ≤ 4394)

